# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard login (change these before going live)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=area2camp

# Random long string used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string
