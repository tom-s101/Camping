# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# The site only ever talks to Supabase from the server (via the service role
# key below) -- there's no anon key in use, since /api/register is the only
# thing allowed to call submit_registration().
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo (https://www.brevo.com) transactional email, used to send the
# registration confirmation email. Get BREVO_API_KEY from Brevo's dashboard
# under SMTP & API -> API Keys. BREVO_SENDER_EMAIL must be a verified sender
# (or domain) in that same Brevo account, or sends will be rejected.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME=Sanctuary Camp 2026

# Admin dashboard login (change these before going live)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=area2camp

# Random long string used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# The site's real deployed URL (no trailing slash). Required for the banner
# image to show up correctly when a link to the site is shared (Facebook,
# Messenger, iMessage, etc.) — without it, link previews will be broken.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.com
